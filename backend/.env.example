# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mining-rush

# Required for POST /api/admin/reset. Change this in your real .env file.
ADMIN_PASSWORD=change-this-admin-password

# Comma-separated browser origins permitted to call this API.
# This value is mandatory when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
